---
import Decor from './Decor.astro';
---
<section class="about" id="about">
  <div class="container">
    <span class="eyebrow">03 / The Garage</span>
    <div class="about-grid" style="margin-top: 32px;">
      <h2>
        One<br />
        <em>industry.</em>
      </h2>
      <div class="about-body">
        <p>
          K22B is a software garage out of Dhaka, focused on manufacturing. We build
          the systems factories run on, and the sites they show up with.
        </p>
        <p>
          Founded in 2026 by <em>Siam Rahman</em>. Whether you're trying a product or
          briefing a build, you talk to the person writing the code.
        </p>
      </div>
    </div>
  </div>

  <Decor type="striped-circle" size={140} style="top: 12%; right: -40px; color: var(--ink);" class="float" />
  <Decor type="sparkle" size={22} style="bottom: 14%; right: 12%; color: var(--ink);" class="float float-delay" />
</section>
