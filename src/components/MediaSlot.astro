---
// A media slot that showcases a photo, GIF, or demo video — styled in Vento's
// design language (soft rounded surfaces, subtle shadow, brand accents).
//
// It renders a polished placeholder by default. The moment you drop a real file
// at `src` (see public/vento/README.md for the expected names), the slot detects
// the successful load and swaps the placeholder for the media — no code changes.
//
// Modes:
//   chrome  — wraps the media in a faux browser window (dots + URL pill)
//   bare    — no card/border/caption; fills a parent frame (used by the pinned
//             scrollytelling panel, which supplies its own frame)
interface Props {
  kind: 'video' | 'gif' | 'photo';
  src: string;
  label?: string;
  aspect?: string;   // CSS aspect-ratio, e.g. "16/9"
  poster?: string;   // optional poster image for videos
  chrome?: boolean;  // render a faux browser window around the media
  url?: string;      // URL text shown in the chrome bar
  bare?: boolean;    // fill parent frame, no card chrome of its own
  loop?: boolean;    // silent auto-looping ambient clip (no controls)
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const {
  kind, src, label = '', aspect = kind === 'video' ? '16/9' : '16/10',
  poster, chrome = false, url = 'vento.app', bare = false, loop = false,
} = Astro.props;
const mediaUrl = src.startsWith('http') ? src : `${base}${src.startsWith('/') ? '' : '/'}${src}`;
const posterUrl = poster ? (poster.startsWith('http') ? poster : `${base}${poster.startsWith('/') ? '' : '/'}${poster}`) : undefined;
const kindLabel = kind === 'video' ? 'Demo video' : kind === 'gif' ? 'GIF' : 'Photo';
---
<figure class:list={["media", { "media--chrome": chrome && !bare, "media--bare": bare }]} style={`--aspect:${aspect};`}>
  {chrome && !bare && (
    <div class="media-bar">
      <span class="media-dots"><i></i><i></i><i></i></span>
      <span class="media-url">{url}</span>
    </div>
  )}
  <div class="media-frame" data-media>
    {kind === 'video' ? (
      <video
        class="media-el" data-el
        controls={!loop}
        autoplay={loop} muted={loop} loop={loop}
        preload="metadata" playsinline poster={posterUrl}
      >
        <source src={mediaUrl} />
      </video>
    ) : (
      <img class="media-el" data-el src={mediaUrl} alt={label} loading="lazy" decoding="async" />
    )}

    <div class="media-ph" data-ph aria-hidden="true">
      <span class="media-ph-icon">
        {kind === 'video' ? (
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="3" />
            <path d="m10 8 6 4-6 4V8z" fill="currentColor" stroke="none" />
          </svg>
        ) : kind === 'gif' ? (
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="3" />
            <path d="M9.5 9.5A2.5 2.5 0 1 0 12 13h-1.5 M14 9.5v5 M16.5 9.5v5 M16.5 9.5h2.5 M16.5 12h2" />
          </svg>
        ) : (
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="3" />
            <circle cx="8" cy="9.5" r="1.6" />
            <path d="m3 17 5-5 4 4 3.5-3.5L21 16" />
          </svg>
        )}
      </span>
      <span class="media-ph-kind">{kindLabel}</span>
      <span class="media-ph-path">{src}</span>
      <span class="media-ph-hint">Drop the file here to go live</span>
    </div>
  </div>
  {label && !bare && <figcaption class="media-cap">{label}</figcaption>}
</figure>

<style>
  .media { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .media-frame {
    position: relative;
    aspect-ratio: var(--aspect, 16 / 9);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg, 16px);
    background: var(--color-surface, #fff);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .media-el {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.4s var(--ease-out-quart, ease);
    z-index: 2;
  }
  .media-el.is-ready { opacity: 1; }
  video.media-el { object-fit: contain; background: var(--color-ink, #0b0f14); }

  .media-ph {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 7px;
    text-align: center;
    padding: 20px;
    background: radial-gradient(120% 120% at 50% 0%, var(--color-paper-soft, #fbfaf7) 0%, var(--color-paper, #f7f6f2) 100%);
  }
  .media-ph.is-hidden { display: none; }
  .media-ph-icon {
    display: grid; place-items: center;
    width: 48px; height: 48px;
    border-radius: var(--radius-md, 8px);
    background: var(--color-brand-50, #fdecec);
    color: var(--color-brand-500, #c11318);
    margin-bottom: 2px;
  }
  .media-ph-kind { font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-ink-soft, #1f2937); }
  .media-ph-path { font-family: var(--font-mono); font-size: 11px; color: var(--color-mute, #5b6573); word-break: break-all; }
  .media-ph-hint { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-mute-soft, #93a0b1); }
  .media-cap { font-size: 13px; color: var(--color-mute, #5b6573); }

  /* chrome (faux browser window) */
  .media--chrome .media-frame { box-shadow: none; }
  .media--chrome {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg, 16px);
    box-shadow: var(--shadow-lift);
    overflow: hidden;
    background: var(--color-surface, #fff);
    gap: 0;
  }
  .media--chrome .media-frame { border: 0; border-radius: 0; border-top: 1px solid var(--color-line); }
  .media-bar {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 14px;
    background: var(--color-paper-soft, #fbfaf7);
  }
  .media-dots { display: inline-flex; gap: 6px; }
  .media-dots i { width: 10px; height: 10px; border-radius: 999px; background: var(--color-line, #e5e7eb); display: block; }
  .media-dots i:nth-child(1) { background: #ff5f57; }
  .media-dots i:nth-child(2) { background: #febc2e; }
  .media-dots i:nth-child(3) { background: #28c840; }
  .media-url {
    flex: 1;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--color-mute, #5b6573);
    background: var(--color-surface, #fff);
    border: 1px solid var(--color-line, #e5e7eb);
    border-radius: 999px;
    padding: 4px 12px;
    max-width: 280px;
    margin: 0 auto;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  /* bare (fills a parent-supplied frame) */
  .media--bare { position: absolute; inset: 0; gap: 0; }
  .media--bare .media-frame {
    position: absolute; inset: 0;
    aspect-ratio: auto;
    border: 0; border-radius: 0; box-shadow: none; background: transparent;
  }
</style>

<script>
  // Reveal real media once it loads; keep the placeholder if the file is missing.
  function wireMedia() {
    document.querySelectorAll<HTMLElement>('[data-media]').forEach((frame) => {
      const el = frame.querySelector<HTMLElement>('[data-el]');
      const ph = frame.querySelector<HTMLElement>('[data-ph]');
      if (!el || !ph) return;
      const reveal = () => { el.classList.add('is-ready'); ph.classList.add('is-hidden'); };
      if (el instanceof HTMLImageElement) {
        if (el.complete && el.naturalWidth > 0) reveal();
        else el.addEventListener('load', reveal, { once: true });
        el.addEventListener('error', () => { el.style.display = 'none'; }, { once: true });
      } else if (el instanceof HTMLVideoElement) {
        el.addEventListener('loadeddata', reveal, { once: true });
        el.addEventListener('error', () => { el.style.display = 'none'; }, { once: true });
      }
    });
  }
  wireMedia();
</script>
