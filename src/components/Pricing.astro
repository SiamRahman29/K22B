---
import Decor from './Decor.astro';

const tiers = [
  {
    slug: 'standard',
    name: 'Standard',
    tagline: 'Get online fast.',
    price: '$599',
    note: 'fixed',
    features: [
      'As many pages / sections',
      'Static site, no dynamic elements',
      'All you need revisions',
      '~10-day delivery',
      'Hosted & deployed',
    ],
    cta: 'Start a build',
    featured: false,
  },
  {
    slug: 'spotlight',
    name: 'Spotlight',
    tagline: 'Get noticed...by humans and AI',
    price: '$1199',
    note: 'fixed',
    features: [
      'Everything in standard',
      'Upto 5 dynamic/backend features',
      'Custom animations & interactions',
      '~10-day delivery',
      'Basic SEO + sitemap + AI SEO',
      'Post-launch support',
    ],
    cta: 'Get ahead',
    featured: true,
  },
  {
    slug: 'special',
    name: 'Special',
    tagline: 'Get a web application just for you',
    price: 'Quote',
    note: 'request a',
    features: [
      'Unlimited scope',
      'Subscription based post-launch support',
    ],
    cta: 'Build your vision',
    featured: false,
  },
];
---

<section class="pricing" id="pricing">
  <div class="container">
    <span class="eyebrow">03 / Pick a build</span>
    <div class="pricing-head" style="margin-top: 24px;">
      <h2>Simple.<br /><em>Scoped.</em></h2>
      <p class="pricing-sub">
        Three tiers, zero templates. Pick the one that matches your scope —
        or <a href="#contact">send a brief</a> and we'll figure it out together.
      </p>
    </div>

    <div class="pricing-grid">
      {tiers.map((t) => (
        <div class:list={['pricing-card', t.featured && 'pricing-card--featured']}>
          <div class="pricing-card-head">
            <div class="pricing-tier-name">{t.name}</div>
            <div class="pricing-tagline">{t.tagline}</div>
          </div>

          <div class="pricing-price-block">
            <span class="pricing-note">{t.note}</span>
            <div class="pricing-price">{t.price}</div>
          </div>

          <ul class="pricing-features">
            {t.features.map((f) => (
              <li>
                <span class="pricing-check">+</span>
                {f}
              </li>
            ))}
          </ul>

          <a class="pricing-cta" href="#contact">
            {t.cta} <span class="arrow">→</span>
          </a>
        </div>
      ))}
    </div>

    <p class="pricing-footer-note">
      All builds are custom — never templated. Price includes design, development, and deployment.
      Have something unusual? <a href="#contact">Brief it anyway.</a>
    </p>
  </div>

  <Decor type="open-circle" size={100} style="top: 6%; right: -24px; color: var(--ink);" class="float" />
  <Decor type="sparkle" size={22} style="top: 30%; left: 8%; color: var(--ink);" class="float float-delay" />
  <Decor type="sparkle" size={16} style="bottom: 28%; right: 8%; color: var(--ink);" class="float" />
</section>
