---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base
  title="K22B Studio: We Ship Web Fast"
  description="K22B Studio is the website studio of K22B: custom websites, shipped fast. Briefs in, live sites out. Built by Siam Rahman in Dhaka."
>
  <Nav
    sub="Studio"
    links={[
      { label: 'Work', href: '#work' },
      { label: 'About', href: '#about' },
      { label: 'Products', href: `${base}/#products` },
    ]}
    cta={{ label: 'Start a build →', href: '#contact' }}
  />
  <main>
    <Hero />
    <About />
    <Projects />
    <Contact />
  </main>
  <Footer />
</Base>
