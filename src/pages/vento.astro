---
import MediaSlot from '../components/MediaSlot.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = 'Vento: Inventory & Manufacturing, Under One Roof';
const description =
  'Vento is an inventory and manufacturing system: track stock by unit or weight, run recipe-driven production batches, and issue branded invoices and delivery receipts. A K22B build.';
const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23c11318'/%3E%3Ctext x='16' y='23' font-family='Inter,Arial,sans-serif' font-size='20' font-weight='700' fill='white' text-anchor='middle'%3EV%3C/text%3E%3C/svg%3E";

// Every clip on this page is a real screen recording. Drop the four files named
// in public/vento/README.md into public/vento/ and they go live; anything
// missing keeps its styled placeholder.
const heroMedia = { src: '/vento/hero.mp4', poster: '/vento/hero-poster.jpg' };

// What Vento is, stated in the hero. Drawn from the app itself, not from the
// recordings: five roles (viewer, factory, operator, manager, admin), products
// that manufacture over a phased timeline, and a fully bilingual interface.
const highlights = [
  'Units, weight, or both',
  'Recipe-driven batches',
  'Timed production runs',
  'Branded invoices & receipts',
  'Five access roles',
  'English & বাংলা',
];

// The hero recording is one unbroken run through the app. Each chapter below
// seeks the hero video to `at` (seconds), so the copy and the footage stay in
// step. `icon` holds lucide-style SVG path markup.
const chapters = [
  {
    at: 8,
    stamp: '00:08',
    kicker: 'Raw materials',
    title: 'Stock, two ways at once',
    body:
      'Register an input by units, by weight, or by both at once. Give it a starting count and a starting weight and Vento derives the weight per unit for you, then carries a set price and a buying price on each scale.',
    icon: '<path d="M16.5 9.4 7.55 4.24"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.27 6.96 12 12.01l8.73-5.05"/><path d="M12 22.08V12"/>',
  },
  {
    at: 80,
    stamp: '01:20',
    kicker: 'Products & recipes',
    title: 'A product is its recipe',
    body:
      'Registering a product takes two steps: the details, then what it is built from. Every ingredient carries its own input wastage, every build carries its utility costs, and a defects percentage says how much of the output comes back unusable.',
    icon: '<path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M9 12h6"/><path d="M9 16h4"/>',
  },
  {
    at: 155,
    stamp: '02:35',
    kicker: 'Manufacture',
    title: 'Batches out, stock down',
    body:
      'Pick a product, enter a batch size, run it. Vento consumes every ingredient at recipe scale, splits the result into good and defect output, and files the run with who did it and exactly what it ate.',
    icon: '<path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M17 18h1"/><path d="M12 18h1"/><path d="M7 18h1"/>',
  },
  {
    at: 193,
    stamp: '03:13',
    kicker: 'Customers & sales',
    title: 'Ring it up, priced your way',
    body:
      'Keep a customer book, then sell finished products, raw materials, or defect residuals from one form. Prices default to the ones you set, accept a one-off override or a discount, and charges like transport ride along on the total.',
    icon: '<path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 17.5v-11"/>',
  },
];

// The remaining three recordings, each with its own section.
const sections = [
  {
    id: 'orders',
    dark: true,
    eyebrow: 'Orders',
    title: 'Orders in, documents out',
    lead:
      'Record what a customer has asked for, see at a glance whether you can cover it, then turn the fulfilled order into an invoice and a delivery receipt.',
    url: 'vento.app/orders',
    media: { src: '/vento/orders.mp4', poster: '/vento/orders-poster.jpg' },
    label: 'Recording an order, fulfilling it, and printing the paperwork',
    specs: [
      {
        title: 'An order moves no stock',
        body:
          'An order is a promise, not a shipment. It carries a customer, a received date, a due date, and the items asked for. Nothing leaves inventory until the sale happens.',
      },
      {
        title: 'In stock, or short',
        body:
          'Every open order says whether current stock covers it, so a shortfall surfaces while there is still time to manufacture against it.',
      },
      {
        title: 'Invoice and receipt',
        body:
          'Fulfil an order from the sales form and it closes as completed. Download the invoice as a PDF, then prepare a delivery receipt with deliveryman and recipient details, fixed once prepared so every printed copy matches.',
      },
    ],
  },
  {
    id: 'supply',
    dark: false,
    eyebrow: 'Supply',
    title: 'Where the stock came from',
    lead:
      'Suppliers, purchases, and the paperwork that proves them, plus the running account of every move a material has ever made.',
    url: 'vento.app/supplies',
    media: { src: '/vento/supply.mp4', poster: '/vento/supply-poster.jpg' },
    label: 'Suppliers, recording a supply, and proof of purchase',
    specs: [
      {
        title: 'Suppliers on file',
        body:
          'The businesses you buy from, kept with phone, email, and address. The mirror image of the customer book on the selling side.',
      },
      {
        title: 'Supplies raise stock',
        body:
          'Each line of a supply brings one raw material in at its buying price, with utility charges on top, and stock goes up the moment it is recorded.',
      },
      {
        title: 'Proof of purchase',
        body:
          "Every supply carries the supplier's own invoice as an image; it is not optional. Vento holds it for fifteen days and shows the exact date and time it expires.",
      },
    ],
  },
  {
    id: 'admin',
    dark: true,
    eyebrow: 'Admin',
    title: 'The settings that change the arithmetic',
    lead:
      'Admin is not only users and access. It decides how wastage is counted, what your documents look like, and which language the floor works in.',
    url: 'vento.app/admin',
    media: { src: '/vento/admin.mp4', poster: '/vento/admin-poster.jpg' },
    label: 'Wastage convention, letterheads, invites, and the Bangla switch',
    specs: [
      {
        title: 'Wastage convention',
        body:
          'Decide once whether a recipe wastage rate is added on top of the recipe or already inside it. Vento shows the worked example in kilograms and then applies it to every product.',
      },
      {
        title: 'Letterheads',
        body:
          'Upload up to ten named PDFs and your invoices and delivery receipts print onto them. Until you add one, documents carry the built-in Vento header.',
      },
      {
        title: 'Invites, roles, and বাংলা',
        body:
          'Generate a one-time signup code that expires, set or revoke a user’s role, keep your category lists, and switch the whole interface between English and Bangla.',
      },
    ],
  },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="vento-page">
      <!-- Header -->
      <header class="v-nav" data-nav>
        <div class="v-wrap v-nav-inner">
          <a class="v-brand" href="#top">
            <span class="v-logo">V</span>
            <span class="v-brand-word">Vento</span>
          </a>
          <nav class="v-nav-links" aria-label="Primary">
            <a href="#walkthrough">Walkthrough</a>
            <a href="#orders">Orders</a>
            <a href="#supply">Supply</a>
            <a href="#admin">Admin</a>
          </nav>
          <div class="v-nav-cta">
            <a class="v-btn v-btn-ghost v-hide-sm" href={`${base}/`}>Built by K22B</a>
            <a class="v-btn v-btn-primary" href={`${base}/#contact`}>Talk to K22B</a>
          </div>
        </div>
        <span class="v-progress" data-progress aria-hidden="true"></span>
      </header>

      <main>
        <!-- Hero -->
        <section class="v-hero" id="top">
          <div class="v-hero-glow" data-parallax aria-hidden="true"></div>
          <div class="v-wrap v-hero-inner">
            <span class="v-eyebrow" data-reveal>A K22B Product</span>
            <h1 class="v-hero-title">
              <span class="v-line" data-reveal style="--d:1">Inventory &amp; manufacturing,</span>
              <span class="v-line v-grad" data-reveal style="--d:2">under one roof.</span>
            </h1>
            <p class="v-hero-sub" data-reveal style="--d:3">
              The system a small manufacturer runs the floor on: stock counted by
              unit or by weight, recipes that turn raw material into finished
              batches, and goods that leave as branded invoices and delivery
              receipts.
            </p>
            <ul class="v-hero-points" data-reveal style="--d:4">
              {highlights.map((h) => (
                <li class="v-hero-point">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7"/></svg>
                  {h}
                </li>
              ))}
            </ul>

            <div class="v-hero-media" data-reveal style="--d:5" data-hero-media>
              <MediaSlot
                kind="video"
                src={heroMedia.src}
                poster={heroMedia.poster}
                url="vento.app · raw material to sale"
                chrome
                aspect="1286/794"
              />
            </div>
          </div>

          <a class="v-scrollcue" href="#stats" aria-label="Scroll">
            <span>Scroll</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </a>
        </section>

        <!-- Stat strip -->
        <section class="v-stats-band" id="stats">
          <div class="v-wrap v-stats">
            <div class="v-stat" data-reveal style="--d:0"><div class="v-stat-num">12</div><div class="v-stat-label">Sections, dashboard through admin</div></div>
            <div class="v-stat" data-reveal style="--d:1"><div class="v-stat-num">2</div><div class="v-stat-label">Stock scales: units, weight, or both</div></div>
            <div class="v-stat" data-reveal style="--d:2"><div class="v-stat-num">10</div><div class="v-stat-label">Letterheads your documents can print onto</div></div>
            <div class="v-stat" data-reveal style="--d:3"><div class="v-stat-num">2</div><div class="v-stat-label">Languages: English and বাংলা</div></div>
          </div>
        </section>

        <!-- Dark cinematic statement -->
        <section class="v-statement v-dark">
          <div class="v-statement-glow" aria-hidden="true"></div>
          <div class="v-wrap">
            <span class="v-eyebrow v-eyebrow-light" data-reveal>One system</span>
            <p class="v-statement-text">
              <span data-reveal style="--d:0">From raw material</span>
              <span data-reveal style="--d:1">to a finished invoice:</span>
              <span class="v-grad" data-reveal style="--d:2">one place, no spreadsheets.</span>
            </p>
          </div>
        </section>

        <!-- Walkthrough chapters: each card seeks the hero recording -->
        <section class="v-section" id="walkthrough">
          <div class="v-wrap">
            <div class="v-section-head" data-reveal>
              <span class="v-eyebrow">The loop</span>
              <h2 class="v-h2">Raw material to sale, in four moves</h2>
              <p class="v-lead">
                Everything a build passes through, in the order it happens. Pick one
                to watch that part of it.
              </p>
            </div>

            <div class="v-chapters">
              {chapters.map((c, i) => (
                <button class="v-chapter-card" type="button" data-seek={c.at} data-reveal style={`--d:${i}`}>
                  <span class="v-chapter-top">
                    <span class="v-feature-icon">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} />
                    </span>
                    <span class="v-time">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                      {c.stamp}
                    </span>
                  </span>
                  <span class="v-kicker">{c.kicker}</span>
                  <span class="v-feature-title">{c.title}</span>
                  <span class="v-feature-body">{c.body}</span>
                </button>
              ))}
            </div>
            <p class="v-chapters-note" data-reveal>Chapters jump the recording above to that moment.</p>
          </div>
        </section>

        <!-- The other three recordings -->
        {sections.map((s) => (
          <section class:list={["v-chapter-section", { "v-dark": s.dark }]} id={s.id}>
            {s.dark && <div class="v-chapter-glow" aria-hidden="true"></div>}
            <div class="v-wrap">
              <div class="v-section-head" data-reveal>
                <span class:list={["v-eyebrow", { "v-eyebrow-light": s.dark }]}>{s.eyebrow}</span>
                <h2 class:list={["v-h2", { "v-h2-light": s.dark }]}>{s.title}</h2>
                <p class:list={["v-lead", { "v-lead-light": s.dark }]}>{s.lead}</p>
              </div>

              <div class="v-specs">
                {s.specs.map((sp, i) => (
                  <div class="v-spec" data-reveal style={`--d:${i}`}>
                    <span class="v-spec-num">{String(i + 1).padStart(2, '0')}</span>
                    <h3 class="v-spec-title">{sp.title}</h3>
                    <p class="v-spec-body">{sp.body}</p>
                  </div>
                ))}
              </div>

              <div class="v-chapter-media" data-reveal>
                <MediaSlot
                  kind="video"
                  src={s.media.src}
                  poster={s.media.poster}
                  label={s.label}
                  url={s.url}
                  chrome
                  aspect="1286/794"
                />
              </div>
            </div>
          </section>
        ))}

        <!-- CTA band -->
        <section class="v-cta">
          <div class="v-wrap v-cta-inner">
            <div data-reveal>
              <h2 class="v-cta-title">Want a system like Vento?</h2>
              <p class="v-cta-sub">K22B builds custom operations software: briefs in, working systems out.</p>
            </div>
            <div class="v-cta-actions" data-reveal style="--d:1">
              <a class="v-btn v-btn-invert v-btn-lg" href={`${base}/#contact`}>Start a build</a>
              <a class="v-btn v-btn-outline-light v-btn-lg" href={`${base}/`}>Back to K22B</a>
            </div>
          </div>
        </section>
      </main>

      <footer class="v-footer">
        <div class="v-wrap v-footer-inner">
          <span class="v-footer-brand"><span class="v-logo v-logo-sm">V</span> Vento</span>
          <span>A K22B build · Dhaka, Bangladesh</span>
        </div>
      </footer>
    </div>

    <style is:global>
      /* ---------- Vento design tokens (ported from vento-frontend) ---------- */
      .vento-page {
        --color-brand-50: #fdecec; --color-brand-100: #f9cfd0;
        --color-brand-500: #c11318; --color-brand-600: #a2181a; --color-brand-700: #861416; --color-brand-800: #6b1011;
        --color-accent-50: #fdf6e7; --color-accent-400: #e89a2c; --color-accent-500: #c87d18; --color-accent-600: #9d5f10;
        --color-ink: #0b0f14; --color-ink-soft: #1f2937; --color-mute: #5b6573; --color-mute-soft: #93a0b1;
        --color-line: #e5e7eb; --color-line-soft: #f1f3f6;
        --color-paper: #f7f6f2; --color-paper-soft: #fbfaf7; --color-surface: #ffffff;
        --radius-sm: 4px; --radius-md: 8px; --radius-lg: 16px; --radius-xl: 24px;
        --shadow-card: 0 1px 2px 0 rgb(11 15 20 / 0.04), 0 1px 1px 0 rgb(11 15 20 / 0.04);
        --shadow-lift: 0 8px 24px -8px rgb(11 15 20 / 0.12), 0 2px 6px -2px rgb(11 15 20 / 0.08);
        --shadow-xl: 0 40px 80px -24px rgb(11 15 20 / 0.32), 0 12px 32px -12px rgb(11 15 20 / 0.22);
        --ease-out-quart: cubic-bezier(0.25, 1, 0.5, 1);
        --font-sans: "Inter", "Noto Sans Bengali", ui-sans-serif, system-ui, sans-serif;
        --font-mono: "JetBrains Mono", ui-monospace, "SFMono-Regular", monospace;
        --v-max: 1120px; --v-pad: clamp(20px, 4vw, 40px);
      }

      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
      body { margin: 0; }

      .vento-page {
        background: var(--color-paper-soft); color: var(--color-ink);
        font-family: var(--font-sans); font-feature-settings: "ss01", "cv11";
        line-height: 1.55; text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;
        overflow-x: hidden;
      }
      /* Buttons are excluded: a bare `.vento-page a` selector outranks the
         single-class .v-btn-* colours, which would leave them inheriting the
         surrounding text colour (white on white in the CTA band). */
      .vento-page a { text-decoration: none; }
      .vento-page a:not(.v-btn) { color: inherit; }
      .vento-page img { display: block; max-width: 100%; height: auto; }
      .vento-page ::selection { background: var(--color-brand-100); color: var(--color-ink); }
      .vento-page :focus-visible { outline: 2px solid var(--color-brand-500); outline-offset: 2px; border-radius: 2px; }
      .vento-page h1, .vento-page h2, .vento-page h3 { margin: 0; letter-spacing: -0.02em; }
      .vento-page p { margin: 0; }

      .v-wrap { width: 100%; max-width: var(--v-max); margin: 0 auto; padding-left: var(--v-pad); padding-right: var(--v-pad); }

      /* ---------- scroll reveal ---------- */
      [data-reveal] {
        opacity: 0;
        transform: translateY(26px);
        transition: opacity 0.7s var(--ease-out-quart), transform 0.7s var(--ease-out-quart);
        transition-delay: calc(var(--d, 0) * 80ms);
        will-change: opacity, transform;
      }
      [data-reveal].is-visible { opacity: 1; transform: none; }

      /* ---------- eyebrow / headings ---------- */
      .v-eyebrow { display: inline-block; font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-brand-600); }
      .v-eyebrow-light { color: var(--color-accent-400); }
      .v-h2 { margin-top: 14px; font-size: clamp(28px, 4vw, 42px); font-weight: 600; line-height: 1.1; }
      .v-h2-light { color: #fff; }
      .v-lead { margin-top: 12px; font-size: clamp(16px, 1.4vw, 18px); color: var(--color-mute); max-width: 56ch; }
      .v-lead-light { color: rgb(255 255 255 / 0.7); }
      .v-grad {
        background: linear-gradient(100deg, var(--color-brand-500) 0%, var(--color-accent-400) 100%);
        -webkit-background-clip: text; background-clip: text; color: transparent;
      }

      /* ---------- buttons ---------- */
      .v-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; border-radius: var(--radius-md); font-size: 14px; font-weight: 500; padding: 9px 16px; border: 1px solid transparent; transition: background-color 0.18s var(--ease-out-quart), color 0.18s, border-color 0.18s, transform 0.18s, box-shadow 0.18s; cursor: pointer; white-space: nowrap; }
      .v-btn-lg { padding: 12px 22px; font-size: 15px; }
      .v-btn-primary { background: var(--color-brand-500); color: #fff; box-shadow: 0 6px 18px -8px rgb(193 19 24 / 0.6); }
      .v-btn-primary:hover { background: var(--color-brand-700); transform: translateY(-1px); box-shadow: 0 10px 24px -8px rgb(193 19 24 / 0.55); }
      .v-btn-ghost { background: transparent; color: var(--color-mute); }
      .v-btn-ghost:hover { color: var(--color-ink); background: var(--color-line-soft); }
      .v-btn-invert { background: #fff; color: var(--color-brand-700); }
      .v-btn-invert:hover { background: var(--color-brand-50); transform: translateY(-1px); }
      .v-btn-outline-light { background: transparent; color: #fff; border-color: rgb(255 255 255 / 0.5); }
      .v-btn-outline-light:hover { background: rgb(255 255 255 / 0.12); border-color: #fff; }

      /* ---------- header ---------- */
      .v-nav { position: sticky; top: 0; z-index: 50; background: rgb(251 250 247 / 0.72); backdrop-filter: saturate(180%) blur(12px); -webkit-backdrop-filter: saturate(180%) blur(12px); border-bottom: 1px solid transparent; transition: border-color 0.25s, box-shadow 0.25s, background-color 0.25s; }
      .v-nav.is-scrolled { border-bottom-color: var(--color-line); box-shadow: 0 1px 0 rgb(11 15 20 / 0.02), 0 6px 24px -18px rgb(11 15 20 / 0.5); }
      .v-nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; height: 64px; }
      .v-brand { display: inline-flex; align-items: center; gap: 10px; }
      .v-logo { display: grid; place-items: center; width: 32px; height: 32px; border-radius: var(--radius-md); background: var(--color-brand-500); color: #fff; font-weight: 700; font-size: 16px; box-shadow: 0 4px 12px -4px rgb(193 19 24 / 0.5); }
      .v-logo-sm { width: 24px; height: 24px; font-size: 13px; border-radius: var(--radius-sm); box-shadow: none; }
      .v-brand-word { font-size: 18px; font-weight: 600; letter-spacing: -0.01em; }
      .v-nav-links { display: none; gap: 4px; }
      .v-nav-links a { padding: 8px 12px; border-radius: var(--radius-md); font-size: 14px; font-weight: 500; color: var(--color-mute); transition: color 0.15s, background-color 0.15s; }
      .v-nav-links a:hover { color: var(--color-ink); background: var(--color-line-soft); }
      .v-nav-cta { display: inline-flex; align-items: center; gap: 8px; }
      @media (min-width: 860px) { .v-nav-links { display: inline-flex; } }
      @media (max-width: 560px) { .v-hide-sm { display: none; } }
      .v-progress { position: absolute; left: 0; bottom: -1px; height: 2px; width: 100%; transform: scaleX(0); transform-origin: 0 50%; background: linear-gradient(90deg, var(--color-brand-500), var(--color-accent-400)); }

      /* ---------- hero ---------- */
      /* Hero fills the viewport below the 64px sticky nav, so only the hero is
         visible on landing and the section below never peeks in. Content taller
         than the viewport just overflows the min-height, never clipped. */
      .v-hero { position: relative; overflow: hidden; min-height: calc(100svh - 64px); display: flex; flex-direction: column; padding: clamp(28px, 4vw, 56px) 0 clamp(20px, 2.5vw, 36px); text-align: center; }
      .v-hero-glow { position: absolute; top: -20%; left: 50%; width: min(1100px, 130vw); height: 720px; transform: translateX(-50%); background: radial-gradient(45% 45% at 50% 40%, rgb(193 19 24 / 0.16), transparent 70%), radial-gradient(40% 40% at 30% 30%, rgb(232 154 44 / 0.16), transparent 70%); filter: blur(10px); pointer-events: none; z-index: 0; }
      .v-hero-inner { position: relative; z-index: 1; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; }
      .v-hero-title { margin-top: 20px; font-size: clamp(38px, 6.4vw, 68px); font-weight: 700; line-height: 1.03; letter-spacing: -0.03em; max-width: 16ch; }
      .v-line { display: block; }
      .v-hero-sub { margin-top: 22px; font-size: clamp(16px, 1.6vw, 20px); color: var(--color-mute); max-width: 56ch; }
      .v-hero-points { margin: 30px 0 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; max-width: 720px; }
      .v-hero-point { display: inline-flex; align-items: center; gap: 8px; padding: 8px 15px; border: 1px solid var(--color-line); border-radius: 999px; background: var(--color-surface); box-shadow: var(--shadow-card); font-size: 13.5px; font-weight: 500; color: var(--color-ink-soft); }
      .v-hero-point svg { flex: none; color: var(--color-brand-500); }
      .v-hero-media { margin-top: clamp(40px, 6vw, 72px); width: 100%; max-width: 960px; }
      .v-hero-media .media--chrome { box-shadow: var(--shadow-xl); }
      .v-scrollcue { position: relative; z-index: 1; margin: clamp(28px, 4vw, 44px) auto 0; display: inline-flex; flex-direction: column; align-items: center; gap: 4px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-mute); width: 100%; }
      .v-scrollcue svg { animation: v-bounce 1.8s var(--ease-out-quart) infinite; }
      @keyframes v-bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(5px); } }

      /* ---------- stat band ---------- */
      .v-stats-band { border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); background: var(--color-surface); }
      .v-stats { display: grid; grid-template-columns: repeat(2, 1fr); }
      @media (min-width: 760px) { .v-stats { grid-template-columns: repeat(4, 1fr); } }
      .v-stat { padding: 28px 8px; }
      @media (min-width: 760px) { .v-stat { padding: 40px 24px; } }
      .v-stat-num { font-size: clamp(38px, 5vw, 56px); font-weight: 700; line-height: 1; letter-spacing: -0.03em; color: var(--color-brand-600); }
      .v-stat-label { margin-top: 10px; font-size: 13px; color: var(--color-mute); max-width: 22ch; }

      /* ---------- dark sections ---------- */
      .v-dark { position: relative; overflow: hidden; background: radial-gradient(120% 120% at 50% 0%, #12181f 0%, var(--color-ink) 60%); color: #fff; }

      .v-statement { padding: clamp(80px, 14vw, 180px) 0; text-align: center; }
      .v-statement-glow { position: absolute; inset: 0; background: radial-gradient(50% 60% at 50% 120%, rgb(193 19 24 / 0.22), transparent 70%); pointer-events: none; }
      .v-statement .v-wrap { position: relative; }
      .v-statement-text { margin-top: 24px; font-size: clamp(30px, 5.4vw, 62px); font-weight: 700; letter-spacing: -0.03em; line-height: 1.08; }
      .v-statement-text span { display: block; }

      /* ---------- section scaffolding ---------- */
      .v-section { padding: clamp(64px, 10vw, 120px) 0; }
      .v-section-head { max-width: 640px; margin-bottom: clamp(36px, 5vw, 56px); }

      /* ---------- walkthrough chapter cards ---------- */
      .v-chapters { display: grid; grid-template-columns: 1fr; gap: clamp(16px, 2vw, 24px); }
      @media (min-width: 720px) { .v-chapters { grid-template-columns: repeat(2, 1fr); } }
      .v-chapter-card {
        display: flex; flex-direction: column; align-items: flex-start;
        text-align: left; width: 100%; margin: 0;
        font: inherit; color: inherit; cursor: pointer;
        background: var(--color-surface);
        border: 1px solid var(--color-line);
        border-radius: var(--radius-lg);
        padding: clamp(22px, 2.6vw, 30px);
        box-shadow: var(--shadow-card);
        transition: transform 0.35s var(--ease-out-quart), box-shadow 0.35s var(--ease-out-quart), border-color 0.35s;
      }
      .v-chapter-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-lift); border-color: var(--color-brand-100); }
      .v-chapter-card:hover .v-time { background: var(--color-brand-500); color: #fff; }
      .v-chapter-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; }
      .v-feature-icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: var(--radius-md); background: var(--color-brand-50); color: var(--color-brand-500); transition: transform 0.4s var(--ease-out-quart); }
      .v-chapter-card:hover .v-feature-icon { transform: scale(1.06); }
      .v-time { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.06em; padding: 5px 11px; border-radius: 999px; background: var(--color-brand-50); color: var(--color-brand-600); transition: background-color 0.25s, color 0.25s; }
      .v-kicker { display: block; margin-top: 18px; font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-brand-600); }
      .v-feature-title { display: block; margin-top: 10px; font-size: clamp(21px, 2.2vw, 26px); font-weight: 600; line-height: 1.15; letter-spacing: -0.02em; }
      .v-feature-body { display: block; margin-top: 12px; font-size: clamp(14.5px, 1.2vw, 16px); color: var(--color-mute); }
      .v-chapters-note { margin-top: 22px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-mute-soft); }

      /* ---------- recording sections (orders / supply / admin) ---------- */
      .v-chapter-section { padding: clamp(64px, 10vw, 120px) 0; }
      .v-chapter-section .v-wrap { position: relative; }
      .v-chapter-glow { position: absolute; top: 24%; left: 50%; width: min(900px, 110vw); height: 500px; transform: translateX(-50%); background: radial-gradient(50% 50% at 50% 50%, rgb(193 19 24 / 0.26), transparent 70%); filter: blur(20px); pointer-events: none; }

      .v-specs { display: grid; grid-template-columns: 1fr; gap: clamp(24px, 3vw, 32px); }
      @media (min-width: 780px) { .v-specs { grid-template-columns: repeat(3, 1fr); } }
      .v-spec-num { font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.12em; color: var(--color-brand-600); }
      .v-spec-title { margin-top: 8px; font-size: clamp(16px, 1.5vw, 18px); font-weight: 600; }
      .v-spec-body { margin-top: 8px; font-size: 14.5px; color: var(--color-mute); }
      .v-dark .v-spec-num { color: var(--color-accent-400); }
      .v-dark .v-spec-title { color: #fff; }
      .v-dark .v-spec-body { color: rgb(255 255 255 / 0.62); }

      .v-chapter-media { max-width: 980px; margin: clamp(40px, 5vw, 60px) auto 0; }
      .v-chapter-media .media--chrome { box-shadow: var(--shadow-xl); }
      /* The chrome card clips its children, so the caption needs its own inset. */
      .v-chapter-media .media-cap { padding: 11px 16px 13px; font-size: 12.5px; }
      .v-dark .v-chapter-media .media--chrome { border-color: rgb(255 255 255 / 0.1); background: #12181f; }
      .v-dark .v-chapter-media .media-bar { background: #12181f; }
      .v-dark .v-chapter-media .media-url { background: #1b2531; border-color: rgb(255 255 255 / 0.08); color: var(--color-mute-soft); }
      .v-dark .v-chapter-media .media-frame { border-color: rgb(255 255 255 / 0.1); }
      .v-dark .v-chapter-media .media-cap { color: rgb(255 255 255 / 0.55); }

      /* ---------- CTA band ---------- */
      .v-cta { background: linear-gradient(120deg, var(--color-brand-600), var(--color-brand-500) 60%, var(--color-accent-500)); color: #fff; }
      .v-cta-inner { padding: clamp(48px, 7vw, 88px) var(--v-pad); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 28px; }
      .v-cta-title { font-size: clamp(26px, 3.6vw, 42px); font-weight: 600; }
      .v-cta-sub { margin-top: 10px; color: rgb(255 255 255 / 0.85); font-size: clamp(15px, 1.4vw, 18px); max-width: 44ch; }
      .v-cta-actions { display: flex; flex-wrap: wrap; gap: 12px; }

      /* ---------- footer ---------- */
      .v-footer { background: var(--color-surface); border-top: 1px solid var(--color-line); }
      .v-footer-inner { padding: 24px var(--v-pad); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; font-size: 13px; color: var(--color-mute); }
      .v-footer-brand { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: var(--color-ink); }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        [data-reveal] { opacity: 1 !important; transform: none !important; transition: none !important; }
        .v-scrollcue svg { animation: none; }
        .v-chapter-card:hover { transform: none; }
      }
    </style>

    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1) Scroll-reveal
      const revealEls = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (reduce) {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      } else if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.15 },
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }

      // 2) Chapter cards scrub the hero recording to the moment they describe
      const heroVideo = document.querySelector<HTMLVideoElement>('[data-hero-media] video');
      document.querySelectorAll<HTMLElement>('[data-seek]').forEach((card) => {
        card.addEventListener('click', () => {
          if (!heroVideo) return;
          const at = Number(card.dataset.seek);
          if (!Number.isFinite(at)) return;
          const seek = () => {
            heroVideo.currentTime = at;
            heroVideo.play?.().catch(() => {});
          };
          // currentTime only sticks once the video knows how long it is.
          if (heroVideo.readyState >= 1) seek();
          else heroVideo.addEventListener('loadedmetadata', seek, { once: true });
          heroVideo.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
        });
      });

      // 3) Scroll progress bar + nav state + hero parallax (rAF-throttled)
      const bar = document.querySelector<HTMLElement>('[data-progress]');
      const nav = document.querySelector<HTMLElement>('[data-nav]');
      const glow = document.querySelector<HTMLElement>('[data-parallax]');
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const y = window.scrollY;
          const max = document.documentElement.scrollHeight - window.innerHeight;
          if (bar) bar.style.transform = `scaleX(${max > 0 ? Math.min(y / max, 1) : 0})`;
          if (nav) nav.classList.toggle('is-scrolled', y > 8);
          if (glow && !reduce) glow.style.transform = `translateX(-50%) translateY(${y * 0.14}px)`;
          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>
